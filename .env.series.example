# === Серії мультсеріалу (/series) ===
# Номери телефонів з оплатою (через кому) — для перевірки доступу
SERIES_PAID_PHONES=380671234567,380501234567

# Monobank Merchant API токен
MONOBANK_TOKEN=u_xxx

# URL додатку (для webhook та redirect)
NEXT_PUBLIC_APP_URL=https://yoursite.com

# Telegram для сповіщень про оплату серій
SERIES_TELEGRAM_CHAT_ID=8420828581

# Google Sheets Webhook (Apps Script) — URL розгорнутого Web app
# Інструкція та код: docs/GOOGLE_APPS_SCRIPT_SERIES.js
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Пікселі аналітики
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
