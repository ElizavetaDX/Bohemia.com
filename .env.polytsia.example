# === Полиця (/polytsia) — безкоштовні PDF-гайди ===
# Google Sheets Webhook (Apps Script для таблиці полиці)
# Інструкція та скрипт: docs/GOOGLE_APPS_SCRIPT_POLYTSIA.js
POLYTSIA_GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Resend API Key (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx

# Відправник листа (має бути верифікований домен у Resend або onboarding@resend.dev)
POLYTSIA_FROM_EMAIL=onboarding@resend.dev
